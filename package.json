{
  "name": "gbfs-france",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "catalog": "tsx scripts/build-catalog.ts",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
